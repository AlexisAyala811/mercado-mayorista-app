{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "dist-pruebas",
    "types": ["node"]
  },
  "include": [
    "src/app/dominio/**/*.ts",
    "src/app/aplicacion/**/*.ts",
    "src/app/infraestructura/repositorio-productos-memoria.ts",
    "src/app/infraestructura/repositorio-pedidos-memoria.ts",
    "src/app/infraestructura/procesador-pagos-simulado.ts",
    "src/app/infraestructura/notificador-consola.ts",
    "src/app/pruebas/**/*.ts"
  ]
}
