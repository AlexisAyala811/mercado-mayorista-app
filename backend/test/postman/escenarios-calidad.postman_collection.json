{
  "info": {
    "name": "MAÑAY · Escenarios de calidad (Sprint 2)",
    "description": "Escenarios de atributos de calidad del Sprint 1 contra la API REST /api/v1: AC01 (respuesta), AC03 (idempotencia y UUID reutilizado), AC04 (aislamiento por negocio con auditoría), roles del Encargado con reemplazo (HU12) y límite de intentos de inicio de sesión. Spec 017, T1708.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "maxResponseMs",
      "value": "3000"
    }
  ],
  "item": [
    {
      "name": "AC01 · Disponibilidad y tiempo de respuesta",
      "description": "p95 central < 3 s (AC01). Aquí se mide una petición; la carga se mide con k6.",
      "item": [
        {
          "name": "Salud de la API y la base",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responde 200', () => pm.response.to.have.status(200));",
                  "pm.test('la base de datos está disponible', () => pm.expect(JSON.stringify(pm.response.json())).to.include('up'));",
                  "pm.test('responde en menos de 3 s (AC01)', () => pm.expect(pm.response.responseTime).to.be.below(Number(pm.collectionVariables.get('maxResponseMs'))));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "auth": {
              "type": "noauth"
            },
            "header": [],
            "url": "{{baseUrl}}/health/ready"
          }
        }
      ]
    },
    {
