            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responde 200', () => pm.response.to.have.status(200));",
                  "pm.test('cero registros', () => pm.expect(pm.response.json().total).to.eql(0));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenB}}",
                  "type": "string"
                }
              ]
            },
            "header": [],
            "url": "{{baseUrl}}/receptions?providerId={{providerId}}"
          }
        },
        {
          "name": "El intento queda en la auditoría de B",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responde 200', () => pm.response.to.have.status(200));",
                  "pm.test('registra el intento sobre la recepción de A', () => pm.expect(pm.response.json().items.map((item) => item.resourceId)).to.include(pm.collectionVariables.get('receptionId')));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenB}}",
                  "type": "string"
                }
              ]
            },
            "header": [],
            "url": "{{baseUrl}}/audit/events?action=authorization.cross-business-denied"
          }
        }
