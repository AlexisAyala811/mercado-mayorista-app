    {
      "name": "AC03 · Idempotencia",
      "description": "La misma operación cinco veces deja un solo registro; el mismo UUID con otros datos responde 409 operation-id-conflict sin cambiar el original.",
      "item": [
        {
          "name": "Enviar la misma recepción cinco veces",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const sent = Number(pm.collectionVariables.get('sends') || 0) + 1;",
                  "pm.collectionVariables.set('sends', sent);",
                  "if (sent === 1) pm.collectionVariables.set('operationId', pm.variables.replaceIn('{{$guid}}'));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const sent = Number(pm.collectionVariables.get('sends'));",
                  "pm.test(`envío ${sent}: responde 201`, () => pm.response.to.have.status(201));",
                  "const id = pm.response.json().id;",
                  "if (sent === 1) pm.collectionVariables.set('receptionId', id);",
                  "else pm.test(`envío ${sent}: devuelve la misma recepción`, () => pm.expect(id).to.eql(pm.collectionVariables.get('receptionId')));",
                  "if (sent < 5) pm.execution.setNextRequest(pm.info.requestName);",
                  "else pm.collectionVariables.set('sends', 0);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenA}}",
                  "type": "string"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/receptions",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"clientOperationId\": \"{{operationId}}\",\n  \"providerId\": \"{{providerId}}\",\n  \"driverName\": \"Chofer QA\",\n  \"receivedOn\": \"2026-11-21\",\n  \"expectedVarietyIds\": [\n    \"{{varietyId}}\"\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Solo existe una recepción",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responde 200', () => pm.response.to.have.status(200));",
                  "pm.test('un solo registro tras cinco envíos', () => pm.expect(pm.response.json().total).to.eql(1));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenA}}",
                  "type": "string"
                }
              ]
            },
            "header": [],
            "url": "{{baseUrl}}/receptions?providerId={{providerId}}"
          }
        },
        {
          "name": "Mismo UUID con otros datos",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responde 409', () => pm.response.to.have.status(409));",
                  "pm.test('código operation-id-conflict', () => pm.expect(pm.response.json().code).to.eql('operation-id-conflict'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenA}}",
                  "type": "string"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/receptions",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"clientOperationId\": \"{{operationId}}\",\n  \"providerId\": \"{{providerId}}\",\n  \"driverName\": \"Otro chofer\",\n  \"receivedOn\": \"2026-11-21\",\n  \"expectedVarietyIds\": [\n    \"{{varietyId}}\"\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "El registro original no cambió",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responde 200', () => pm.response.to.have.status(200));",
                  "pm.test('conserva los datos del primer envío', () => pm.expect(pm.response.json().driverName).to.eql('Chofer QA'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenA}}",
                  "type": "string"
                }
              ]
            },
            "header": [],
            "url": "{{baseUrl}}/receptions/{{receptionId}}"
          }
        }
      ]
