{
  "info": {
    "name": "MAÑAY · Administrador de comerciantes (spec 023)",
    "description": "El Administrador da de alta comerciantes y da soporte a sus cuentas (suspender, reactivar, contraseña temporal) sin ver sus operaciones. Spec 023.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Administrador",
      "description": "Sesión del Administrador de la plataforma.",
      "item": [
        {
          "name": "Iniciar sesión · Administrador",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('runId', Date.now().toString(36));",
                  "pm.collectionVariables.set('merchantUser', 'qa_com_' + pm.collectionVariables.get('runId'));",
                  "pm.collectionVariables.set('temporaryPassword', 'Tmp-' + pm.variables.replaceIn('{{$guid}}'));",
                  "pm.collectionVariables.set('finalPassword', 'Fin-' + pm.variables.replaceIn('{{$guid}}'));",
                  "pm.collectionVariables.set('createOperationId', pm.variables.replaceIn('{{$guid}}'));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responde 201', () => pm.response.to.have.status(201));",
                  "pm.test('el rol es Administrador', () => pm.expect(pm.response.json().user.role).to.eql('admin'));",
                  "pm.collectionVariables.set('tokenAdmin', pm.response.json().accessToken);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "auth": {
              "type": "noauth"
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/sessions",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{adminUser}}\",\n  \"password\": \"{{adminPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "No ve operaciones de ningún negocio",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responde 403', () => pm.response.to.have.status(403));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenAdmin}}",
                  "type": "string"
                }
              ]
            },
            "header": [],
            "url": "{{baseUrl}}/receptions"
          }
        }
      ]
    },
    {
      "name": "Alta de comerciante",
      "description": "Negocio y Mayorista en una transacción, idempotente por clientOperationId.",
      "item": [
        {
          "name": "Crear comerciante",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responde 201', () => pm.response.to.have.status(201));",
                  "pm.test('el Mayorista debe crear su contraseña', () => pm.expect(pm.response.json().wholesaler.mustChangePassword).to.eql(true));",
                  "pm.collectionVariables.set('merchantId', pm.response.json().id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenAdmin}}",
                  "type": "string"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/admin/merchants",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"clientOperationId\": \"{{createOperationId}}\",\n  \"businessName\": \"Comercial QA {{runId}}\",\n  \"username\": \"{{merchantUser}}\",\n  \"temporaryPassword\": \"{{temporaryPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Reintento con el mismo UUID",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responde 201', () => pm.response.to.have.status(201));",
                  "pm.test('devuelve el mismo comerciante', () => pm.expect(pm.response.json().id).to.eql(pm.collectionVariables.get('merchantId')));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenAdmin}}",
                  "type": "string"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/admin/merchants",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"clientOperationId\": \"{{createOperationId}}\",\n  \"businessName\": \"Comercial QA {{runId}}\",\n  \"username\": \"{{merchantUser}}\",\n  \"temporaryPassword\": \"{{temporaryPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Buscar el comerciante",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responde 200', () => pm.response.to.have.status(200));",
                  "pm.test('aparece una vez', () => pm.expect(pm.response.json().total).to.eql(1));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenAdmin}}",
                  "type": "string"
                }
              ]
            },
            "header": [],
            "url": "{{baseUrl}}/admin/merchants?search={{merchantUser}}"
          }
        }
      ]
    },
    {
      "name": "Primer acceso del Mayorista",
      "description": "Con la contraseña temporal solo puede crear la suya.",
      "item": [
        {
          "name": "Iniciar sesión con la temporal",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responde 201', () => pm.response.to.have.status(201));",
                  "pm.test('pide cambiar la contraseña', () => pm.expect(pm.response.json().user.mustChangePassword).to.eql(true));",
                  "pm.collectionVariables.set('tokenMerchant', pm.response.json().accessToken);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "auth": {
              "type": "noauth"
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/sessions",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{merchantUser}}\",\n  \"password\": \"{{temporaryPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Otra ruta queda bloqueada",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responde 403', () => pm.response.to.have.status(403));",
                  "pm.test('código password-change-required', () => pm.expect(pm.response.json().code).to.eql('password-change-required'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenMerchant}}",
                  "type": "string"
                }
              ]
            },
            "header": [],
            "url": "{{baseUrl}}/accounts?limit=1"
          }
        },
        {
          "name": "Crear su contraseña",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responde 204', () => pm.response.to.have.status(204));"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenMerchant}}",
                  "type": "string"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/password",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"currentPassword\": \"{{temporaryPassword}}\",\n  \"newPassword\": \"{{finalPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Ya trabaja con normalidad",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responde 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenMerchant}}",
                  "type": "string"
                }
              ]
            },
            "header": [],
            "url": "{{baseUrl}}/accounts?limit=1"
          }
        },
        {
          "name": "No entra a las rutas del Administrador",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responde 403', () => pm.response.to.have.status(403));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenMerchant}}",
                  "type": "string"
                }
              ]
            },
            "header": [],
            "url": "{{baseUrl}}/admin/merchants"
          }
        }
      ]
    },
    {
      "name": "Soporte",
      "description": "Suspender corta el acceso al instante; cada acción lleva motivo y queda auditada.",
      "item": [
        {
          "name": "Suspender",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responde 200', () => pm.response.to.have.status(200));",
                  "pm.test('queda suspendido', () => pm.expect(pm.response.json().isActive).to.eql(false));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenAdmin}}",
                  "type": "string"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/admin/merchants/{{merchantId}}/suspend",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"clientOperationId\": \"{{$guid}}\",\n  \"reason\": \"Prueba de soporte\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "La sesión del Mayorista deja de valer",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responde 401', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenMerchant}}",
                  "type": "string"
                }
              ]
            },
            "header": [],
            "url": "{{baseUrl}}/auth/session"
          }
        },
        {
          "name": "Reactivar",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responde 200', () => pm.response.to.have.status(200));",
                  "pm.test('queda activo', () => pm.expect(pm.response.json().isActive).to.eql(true));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenAdmin}}",
                  "type": "string"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/admin/merchants/{{merchantId}}/reactivate",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"clientOperationId\": \"{{$guid}}\",\n  \"reason\": \"Fin de la prueba\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Estado de la cuenta",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responde 200', () => pm.response.to.have.status(200));",
                  "pm.test('informa intentos fallidos y sesiones', () => pm.expect(pm.response.json()).to.have.keys('activeAssistants', 'failedLoginAttempts', 'lastFailedLoginAt', 'merchant', 'openSessions'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenAdmin}}",
                  "type": "string"
                }
              ]
            },
            "header": [],
            "url": "{{baseUrl}}/admin/merchants/{{merchantId}}/status"
          }
        }
      ]
    }
  ]
}
