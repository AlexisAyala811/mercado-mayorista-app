NODE_ENV=development
PORT=3000
CORS_ORIGINS=http://localhost:8081
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=mercado
DATABASE_PASSWORD=replace-with-at-least-12-characters
DATABASE_NAME=mercado
DATABASE_SSL=false
DATABASE_SSL_REJECT_UNAUTHORIZED=true
DATABASE_POOL_SIZE=10
DATABASE_CONNECT_TIMEOUT_MS=5000
SESSION_TTL_MINUTES=480
EVIDENCE_RETENTION_YEARS=5
OPENAPI_ENABLED=true
# Detrás de un proxy inverso: número de saltos (1) o direcciones de confianza
TRUST_PROXY=false
# Solo en una base desechable cuyo nombre contenga "test"
RUN_DATABASE_E2E=false
# Solo para ejecutar una vez npm run bootstrap:wholesaler
BOOTSTRAP_BUSINESS_NAME=replace-with-business-name
BOOTSTRAP_USERNAME=replace-with-initial-username
BOOTSTRAP_PASSWORD=replace-with-at-least-12-characters
