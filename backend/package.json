{
  "name": "mercado-api",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "oxlint --type-aware src/ test/",
    "typecheck": "tsc --noEmit --incremental false",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch",
    "test:cov": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage",
    "test:debug": "node --experimental-vm-modules --inspect-brk node_modules/jest/bin/jest.js --runInBand",
    "test:report": "node ../.github/scripts/test-report.mjs --suite backend-unit --out test-results/unit --coverage coverage/coverage-summary.json -- node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage",
    "test:report:e2e": "node ../.github/scripts/test-report.mjs --suite backend-e2e --out test-results/e2e -- node --experimental-vm-modules node_modules/jest/bin/jest.js --config jest.config.e2e.mjs --runInBand",
    "test:e2e": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config jest.config.e2e.mjs --runInBand",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build",
    "migration:run": "npm run build && typeorm migration:run -d dist/platform/database/data-source.js",
    "migration:run:prod": "typeorm migration:run -d dist/platform/database/data-source.js",
    "migration:show": "npm run build && typeorm migration:show -d dist/platform/database/data-source.js",
    "migration:revert": "npm run build && typeorm migration:revert -d dist/platform/database/data-source.js",
    "bootstrap:admin": "npm run build && node dist/platform/database/bootstrap-admin.js",
    "bootstrap:wholesaler": "npm run build && node dist/platform/database/bootstrap-wholesaler.js"
  },
  "dependencies": {
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/swagger": "^12.0.2",
    "@nestjs/terminus": "^12.1.0",
    "@nestjs/throttler": "^6.7.1",
    "@nestjs/typeorm": "^12.0.1",
    "@resvg/resvg-js": "2.6.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^18.0.3",
    "exceljs": "4.4.0",
    "joi": "^18.3.1",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^1.1.1"
  },
  "devDependencies": {
    "@jest/globals": "^30.5.2",
    "@nestjs/cli": "^12.0.0",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@swc/core": "^1.16.22",
    "@swc/jest": "^0.2.39",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/pdfkit": "^0.17.6",
    "@types/supertest": "^7.0.0",
    "jest": "^30.5.2",
    "oxlint": "^1.58.0",
    "oxlint-tsgolint": "^7.0.2001",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "typescript": "^6.0.2"
  }
}
