{
  "expo": {
    "name": "MAÑAY",
    "slug": "mercado",
    "version": "1.0.0",
    "icon": "./assets/brand/icon.png",
    "scheme": "mercado",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "package": "com.mercado.gestion",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/brand/adaptive-foreground.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/brand/splash.png",
          "imageWidth": 160
        }
      ],
      "expo-secure-store",
      [
        "expo-font",
        {
          "android": {
            "fonts": [
              { "fontFamily": "LoginInterRegular", "fontDefinitions": [{ "path": "./node_modules/@expo-google-fonts/inter/400Regular/Inter_400Regular.ttf", "weight": 400 }] },
              { "fontFamily": "LoginInterSemiBold", "fontDefinitions": [{ "path": "./node_modules/@expo-google-fonts/inter/600SemiBold/Inter_600SemiBold.ttf", "weight": 600 }] },
              { "fontFamily": "LoginInterBold", "fontDefinitions": [{ "path": "./node_modules/@expo-google-fonts/inter/700Bold/Inter_700Bold.ttf", "weight": 700 }] },
              { "fontFamily": "MercadoInter", "fontDefinitions": [{ "path": "./node_modules/@expo-google-fonts/inter/400Regular/Inter_400Regular.ttf", "weight": 400 }] },
              { "fontFamily": "MercadoRalewayExtraBold", "fontDefinitions": [{ "path": "./node_modules/@expo-google-fonts/raleway/800ExtraBold/Raleway_800ExtraBold.ttf", "weight": 800 }] },
              { "fontFamily": "MercadoBentham", "fontDefinitions": [{ "path": "./node_modules/@expo-google-fonts/bentham/400Regular/Bentham_400Regular.ttf", "weight": 400 }] },
              { "fontFamily": "MercadoBevan", "fontDefinitions": [{ "path": "./node_modules/@expo-google-fonts/bevan/400Regular/Bevan_400Regular.ttf", "weight": 400 }] },
              { "fontFamily": "ReportInterMedium", "fontDefinitions": [{ "path": "./node_modules/@expo-google-fonts/inter/500Medium/Inter_500Medium.ttf", "weight": 500 }] },
              { "fontFamily": "ReportRalewayExtraBold", "fontDefinitions": [{ "path": "./node_modules/@expo-google-fonts/raleway/800ExtraBold/Raleway_800ExtraBold.ttf", "weight": 800 }] },
              { "fontFamily": "ReportRalewayBold", "fontDefinitions": [{ "path": "./node_modules/@expo-google-fonts/raleway/700Bold/Raleway_700Bold.ttf", "weight": 700 }] },
              { "fontFamily": "ReportInterSemiBold", "fontDefinitions": [{ "path": "./node_modules/@expo-google-fonts/inter/600SemiBold/Inter_600SemiBold.ttf", "weight": 600 }] },
              { "fontFamily": "ReportInterRegular", "fontDefinitions": [{ "path": "./node_modules/@expo-google-fonts/inter/400Regular/Inter_400Regular.ttf", "weight": 400 }] }
            ]
          }
        }
      ],
      "expo-sharing",
      "react-native-blob-util",
      "@config-plugins/react-native-pdf",
      "@config-plugins/react-native-blob-util"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
